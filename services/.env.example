# LabNote ELN - 환경 변수 설정
# 이 파일을 .env로 복사한 후 모든 값을 채워주세요.
# 빈 값(=)은 필수 항목입니다 — 미설정 시 docker compose가 시작되지 않습니다.

# ─── 공용 인프라 (필수) ───
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=labnote

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ─── JWT (필수! openssl rand -base64 32 로 생성) ───
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ─── 내부 서비스 간 통신 시크릿 (필수! openssl rand -base64 32 로 생성) ───
INTERNAL_SECRET=

# ─── 시드 계정 비밀번호 (필수! 강력한 비밀번호를 설정하세요) ───
ADMIN_INITIAL_PASSWORD=
RESEARCHER_INITIAL_PASSWORD=
REVIEWER_INITIAL_PASSWORD=

# ─── 서비스 포트 (선택 — 기본값 사용 가능) ───
GATEWAY_PORT=8000
FRONTEND_PORT=3000

# ─── CORS ───
CORS_ORIGIN=http://localhost:3000
