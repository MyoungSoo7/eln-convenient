# LabNote ELN - 환경 변수 설정
# 이 파일을 .env로 복사하여 사용하세요.

# ─── 공용 인프라 ───
POSTGRES_USER=labnote
POSTGRES_PASSWORD=labnote_secret_2024
POSTGRES_DB=labnote

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ─── 서비스 포트 ───
GATEWAY_PORT=8000
AUTH_PORT=8001
ELN_PORT=8002
SIGNATURE_PORT=8003
INVENTORY_PORT=8004
SCHEDULER_PORT=8005
SEARCH_PORT=8006
FILE_PORT=8008

# ─── JWT (TODO: 실제 키로 교체) ───
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# ─── CORS ───
CORS_ORIGIN=http://localhost:3000
