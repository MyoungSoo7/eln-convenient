generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Signature {
  id            String          @id @default(uuid())
  noteId        String
  signerId      String
  signatureHash String
  prevHash      String?         // 이전 서명 해시 (해시 체인)
  chainIndex    Int             @default(0) // 체인 내 순서
  timestamp     DateTime        @default(now())
  status        SignatureStatus @default(valid)

  @@index([noteId])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  details    Json     @default("{}")
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([actorId])
  @@index([createdAt])
}

model ExportJob {
  id          String       @id @default(uuid())
  noteId      String
  noteIds     String[]     @default([])  // zip 일 때 복수 노트
  format      ExportFormat
  status      ExportStatus @default(pending)
  requestedBy String       @default("")
  fileUrl     String?
  errorMsg    String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?
}

enum SignatureStatus {
  valid
  revoked
}

enum ExportFormat {
  pdf
  zip
}

enum ExportStatus {
  pending
  processing
  completed
  failed
}
