generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Signature {
  id            String          @id @default(uuid())
  noteId        String
  signerId      String
  orgId         String          @default("")
  signatureHash String
  prevHash      String?         // 이전 서명 해시 (해시 체인)
  chainIndex    Int             @default(0) // 체인 내 순서
  timestamp     DateTime        @default(now())
  status        SignatureStatus @default(valid)

  @@unique([noteId, chainIndex])
  @@index([noteId, status])
  @@index([signerId])
  @@index([orgId])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  orgId      String     @default("")
  details    Json     @default("{}")
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([orgId, createdAt])
  @@index([orgId, action])
  @@index([orgId, entityType, createdAt])
}

model ExportJob {
  id          String       @id @default(uuid())
  noteId      String
  noteIds     String[]     @default([])  // zip 일 때 복수 노트
  format      ExportFormat
  status      ExportStatus @default(pending)
  requestedBy String       @default("")
  orgId       String     @default("")
  fileUrl     String?
  fileId      String?      // file-service File 레코드 ID (presigned URL 재발급용)
  errorMsg    String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([requestedBy])
  @@index([status])
  @@index([createdAt])
  @@index([orgId])
}

enum SignatureStatus {
  valid
  revoked
}

enum ExportFormat {
  pdf
  zip
  report
}

enum ExportStatus {
  pending
  processing
  completed
  failed
}

// ── 알림 ──

model Notification {
  id             String           @id @default(uuid())
  recipientId    String
  orgId          String           @default("")
  type           NotificationType
  entityType     String           // "note" | "booking"
  entityId       String
  title          String
  message        String
  actorId        String
  actorName      String           @default("")
  isRead         Boolean          @default(false)
  idempotencyKey String?          @unique // 재시도/중복 방지용 키 (e.g. "booking-<id>-approved")
  createdAt      DateTime         @default(now())

  @@index([orgId, recipientId, isRead])
  @@index([recipientId, createdAt])
}

enum NotificationType {
  NOTE_LOCKED
  NOTE_SIGNED
  NOTE_UNLOCKED
  BOOKING_APPROVED
}
