        </mxCell>

        <mxCell id="proxy-table" value="/api/auth → auth:8001&#xa;/api/notes → eln:8002&#xa;/api/signatures → sig:8003&#xa;/api/inventory → inv:8004&#xa;/api/scheduler → sched:8005&#xa;/api/search → search:8006&#xa;/api/files → file:8008" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
