<mxfile host="app.diagrams.net" modified="2026-03-28T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="dashboard-flow" name="대시보드 집계">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="대시보드 집계 흐름 (Promise.allSettled 병렬 요청)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="500" height="40" as="geometry"/>
        </mxCell>

        <!-- User Request -->
        <mxCell id="user" value="👤 사용자&#xa;대시보드 진입" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="130" height="50" as="geometry"/>
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="gw" value="🔀 API Gateway :8000&#xa;GET /api/dashboard/personal&#xa;JWT 검증 → userId, orgId 추출" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="105" width="230" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="user-gw" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="user" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Promise.allSettled fan-out -->
        <mxCell id="fan-label" value="Promise.allSettled (5개 병렬 요청)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="300" y="190" width="280" height="20" as="geometry"/>
        </mxCell>

        <!-- Fan-out point -->
        <mxCell id="fan" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF9800;strokeColor=#F57C00;" vertex="1" parent="1">
          <mxGeometry x="355" y="215" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="gw-fan" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="gw" target="fan"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 5 parallel requests -->
        <mxCell id="req1" value="📊 노트 통계&#xa;ELN :8002&#xa;GET /notes/stats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="120" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="req2" value="📝 최근 노트&#xa;ELN :8002&#xa;GET /notes?limit=5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="220" y="270" width="130" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="req3" value="📅 내 예약&#xa;Scheduler :8005&#xa;GET /bookings?limit=5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="390" y="270" width="130" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="req4" value="🔔 미읽은 알림&#xa;Sig-Audit :8003&#xa;GET /notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="560" y="270" width="130" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="req5" value="📋 최근 활동&#xa;Sig-Audit :8003&#xa;GET /audit?limit=5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="730" y="270" width="130" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="f1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="fan" target="req1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="fan" target="req2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="fan" target="req3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="fan" target="req4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="fan" target="req5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Responses -->
        <mxCell id="resp1" value="✅ {draft:3,&#xa;in_progress:5,&#xa;signed:12}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="120" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="resp2" value="✅ [{note1},&#xa;{note2}, ...]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="220" y="360" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="resp3" value="❌ TIMEOUT&#xa;(서비스 다운)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#F44336;fontSize=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="360" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="resp4" value="✅ {unread: 7}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="360" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="resp5" value="✅ [{action1},&#xa;...]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="360" width="130" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="r1" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;strokeColor=#4CAF50;" edge="1" parent="1" source="req1" target="resp1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;strokeColor=#4CAF50;" edge="1" parent="1" source="req2" target="resp2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;strokeColor=#F44336;" edge="1" parent="1" source="req3" target="resp3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r4" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;strokeColor=#4CAF50;" edge="1" parent="1" source="req4" target="resp4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r5" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;strokeColor=#4CAF50;" edge="1" parent="1" source="req5" target="resp5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Merge point -->
        <mxCell id="merge" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF9800;strokeColor=#F57C00;" vertex="1" parent="1">
          <mxGeometry x="355" y="440" width="20" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="m1" style="endArrow=classic;html=1;strokeWidth=1;" edge="1" parent="1" source="resp1" target="merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m2" style="endArrow=classic;html=1;strokeWidth=1;" edge="1" parent="1" source="resp2" target="merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m3" style="endArrow=classic;html=1;strokeWidth=1;" edge="1" parent="1" source="resp3" target="merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m4" style="endArrow=classic;html=1;strokeWidth=1;" edge="1" parent="1" source="resp4" target="merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m5" style="endArrow=classic;html=1;strokeWidth=1;" edge="1" parent="1" source="resp5" target="merge"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Result Processing -->
        <mxCell id="process" value="🔄 결과 병합&#xa;실패 항목 → 기본값 (빈 배열)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="490" width="210" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="merge-process" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="merge" target="process"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Final Response -->
        <mxCell id="final" value="200 OK&#xa;{ok: true, data: {&#xa;  stats: {...},&#xa;  recentNotes: [...],&#xa;  bookings: [],  ← 실패 시 빈 배열&#xa;  unreadCount: 7,&#xa;  recentActions: [...]&#xa;}}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=9;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="260" y="565" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="process-final" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#4CAF50;" edge="1" parent="1" source="process" target="final"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Frontend rendering -->
        <mxCell id="fe-render" value="🖥️ Frontend 렌더링&#xa;&#xa;• 정상 항목: 데이터 표시&#xa;• 실패 항목: '불러오기 실패' 표시&#xa;• 전체 페이지는 정상 동작" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="final-fe" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;" edge="1" parent="1" source="final" target="fe-render"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Key Insight -->
        <mxCell id="insight" value="💡 핵심: Promise.allSettled vs Promise.all&#xa;&#xa;Promise.all — 하나 실패하면 전체 실패 ❌&#xa;Promise.allSettled — 각각 독립, 실패해도 나머지 정상 ✅&#xa;&#xa;→ Scheduler 서비스가 다운되어도 대시보드는 동작&#xa;→ 예약 영역만 '불러오기 실패' 표시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="480" width="350" height="120" as="geometry"/>
        </mxCell>

        <!-- Caching -->
        <mxCell id="cache-box" value="⚡ 캐싱 전략&#xa;&#xa;• Redis TTL 기반 캐시&#xa;• 캐시 키: cache:dashboard:{userId}:{hash}&#xa;• 서비스별 적절한 만료 시간&#xa;• 내부 인증: x-internal-secret 헤더" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="620" width="300" height="100" as="geometry"/>
        </mxCell>

        <!-- Admin Dashboard note -->
        <mxCell id="admin-note" value="👑 관리자 대시보드&#xa;GET /api/dashboard/admin&#xa;requireRole(ADMIN)&#xa;+ Auth/ELN/Sig 통계 집계" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9C27B0;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="940" y="120" width="220" height="70" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
