<mxfile host="app.diagrams.net" modified="2026-03-28T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="signing-flow" name="노트 서명 흐름">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="노트 전자서명 흐름 (Sequence)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="500" height="40" as="geometry"/>
        </mxCell>

        <!-- Actors/Systems (vertical lanes) -->
        <mxCell id="lane-reviewer" value="Reviewer / Admin" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="120" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="lane-gw" value="API Gateway&#xa;:8000" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="80" width="120" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="lane-sig" value="Signature&#xa;Audit :8003" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="120" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="lane-auth" value="Auth Service&#xa;:8001" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="120" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="lane-redis" value="Redis Stream" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="80" width="120" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="lane-eln" value="ELN Service&#xa;:8002" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="80" width="120" height="850" as="geometry"/>
        </mxCell>

        <!-- Step 1: Sign Request -->
        <mxCell id="step1" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="160" as="sourcePoint"/>
            <mxPoint x="340" y="160" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="step1-label" value="1. POST /api/signatures/sign/{noteId}&#xa;{password, comment}" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="145" y="130" width="190" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 2: JWT Verify + Proxy -->
        <mxCell id="step2" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="200" as="sourcePoint"/>
            <mxPoint x="540" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="step2-label" value="2. JWT 검증 → 프록시&#xa;x-user-id, x-user-role 주입" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="350" y="170" width="180" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 3: Permission Check -->
        <mxCell id="step3-box" value="3. requirePermission&#xa;(note:sign) 검증" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFE6;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="220" width="130" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 4: Password Verify -->
        <mxCell id="step4" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0000FF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="290" as="sourcePoint"/>
            <mxPoint x="740" y="290" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="step4-label" value="4. POST /internal/verify-password&#xa;x-internal-secret" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#0000FF;" vertex="1" parent="1">
          <mxGeometry x="560" y="260" width="170" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 4 Response -->
        <mxCell id="step4r" value="" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;strokeColor=#0000FF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="320" as="sourcePoint"/>
            <mxPoint x="540" y="320" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="step4r-label" value="{verified: true}" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#0000FF;" vertex="1" parent="1">
          <mxGeometry x="590" y="305" width="100" height="15" as="geometry"/>
        </mxCell>

        <!-- Step 5: Hash Chain -->
        <mxCell id="step5-box" value="5. 해시체인 서명 생성&#xa;SHA-256(noteId:signerId:&#xa;timestamp:prevHash:comment)&#xa;→ DB 저장 (Signature)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="350" width="170" height="70" as="geometry"/>
        </mxCell>

        <!-- Step 6: Redis Stream Event -->
        <mxCell id="step6" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF0000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="450" as="sourcePoint"/>
            <mxPoint x="940" y="450" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="step6-label" value="6. XADD labnote:events&#xa;{type: NOTE_SIGNED, noteId, userId}" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#FF0000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="420" width="250" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 7: Response to client -->
        <mxCell id="step7a" value="" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="490" as="sourcePoint"/>
            <mxPoint x="340" y="490" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="step7b" value="" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="510" as="sourcePoint"/>
            <mxPoint x="140" y="510" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="step7-label" value="7. 200 OK {signature}" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#008800;" vertex="1" parent="1">
          <mxGeometry x="200" y="490" width="130" height="20" as="geometry"/>
        </mxCell>

        <!-- Async divider -->
        <mxCell id="divider" value="" style="endArrow=none;html=1;strokeWidth=1;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="550" as="sourcePoint"/>
            <mxPoint x="1200" y="550" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="divider-label" value="⚡ 비동기 처리 (Redis Stream Consumer)" style="text;html=1;strokeColor=none;fillColor=#FFFFCC;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="450" y="535" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 8: ELN Consumer -->
        <mxCell id="step8" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF0000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="940" y="590" as="sourcePoint"/>
            <mxPoint x="1140" y="590" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="step8-label" value="8. XREADGROUP&#xa;→ NOTE_SIGNED 이벤트 수신" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="940" y="560" width="190" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 9: Status Update -->
        <mxCell id="step9-box" value="9. handleNoteSigned()&#xa;note.status = 'signed'&#xa;+ NoteStatusHistory 기록&#xa;+ AuditLog 기록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="620" width="170" height="70" as="geometry"/>
        </mxCell>

        <!-- Step 10: XACK -->
        <mxCell id="step10" value="" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;strokeColor=#FF0000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1140" y="720" as="sourcePoint"/>
            <mxPoint x="940" y="720" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="step10-label" value="10. XACK (소비 완료)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="960" y="705" width="150" height="15" as="geometry"/>
        </mxCell>

        <!-- Fallback box -->
        <mxCell id="fallback" value="⚠️ Redis 실패 시 HTTP 폴백&#xa;&#xa;Signature-Audit → ELN Service&#xa;PATCH /api/notes/{id}/status&#xa;x-user-role: system&#xa;{status: &quot;signed&quot;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="770" width="280" height="100" as="geometry"/>
        </mxCell>

        <!-- Key Points box -->
        <mxCell id="keypoints" value="🔑 핵심 포인트&#xa;&#xa;• Researcher는 note:sign 없음 → 403&#xa;• 비밀번호 이중 검증 (JWT + 서명 시)&#xa;• 해시체인으로 위변조 탐지&#xa;• signed 상태는 불변 (되돌리기 불가)&#xa;• Dead Letter: 5회 초과 → ACK + 수동복구" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="770" width="280" height="120" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>