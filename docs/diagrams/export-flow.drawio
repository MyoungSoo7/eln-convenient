<mxfile host="app.diagrams.net" modified="2026-03-28T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="export-flow" name="내보내기 흐름">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="파일 내보내기(Export) 흐름 — BullMQ → Puppeteer → MinIO → SSE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="700" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== 동기 구간 ========== -->
        <mxCell id="sync-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#90CAF9;dashed=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="680" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="sync-label" value="동기 구간 (사용자 대기)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="50" y="85" width="200" height="20" as="geometry"/>
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="s1" value="👤 사용자&#xa;PDF 내보내기 클릭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="130" height="50" as="geometry"/>
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="s2" value="🔀 API Gateway&#xa;Rate Limit:&#xa;10 req/60s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="120" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="s3" value="✍️ Signature-Audit&#xa;:8003" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="120" width="130" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="a1" value="POST /api/export&#xa;{noteId, format: 'pdf'}" style="endArrow=classic;html=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- DB + Queue -->
        <mxCell id="s3-db" value="① ExportJob 생성&#xa;status: 'queued'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="400" y="195" width="150" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="s3-q" value="② BullMQ enqueue&#xa;attempts: 3, backoff: exp 5s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="400" y="245" width="150" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="a3a" style="endArrow=classic;html=1;strokeWidth=1;" edge="1" parent="1" source="s3" target="s3-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3b" style="endArrow=classic;html=1;strokeWidth=1;" edge="1" parent="1" source="s3-db" target="s3-q"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Response -->
        <mxCell id="resp" value="202 Accepted&#xa;{jobId, status: 'queued'}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="a-resp" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;strokeColor=#4CAF50;" edge="1" parent="1" source="s3" target="resp"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- SSE Connection -->
        <mxCell id="sse-start" value="🔔 Frontend&#xa;SSE 연결 시작&#xa;GET /api/events/exports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="195" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="a-sse" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;" edge="1" parent="1" source="resp" target="sse-start"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ========== 비동기 구간 ========== -->
        <mxCell id="async-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FFB74D;dashed=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1400" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="async-label" value="비동기 구간 (BullMQ Worker — concurrency: 2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="50" y="335" width="400" height="20" as="geometry"/>
        </mxCell>

        <!-- Worker Step 1: Fetch Note -->
        <mxCell id="w1" value="⚙️ Export Worker&#xa;작업 수신" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="130" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="w2" value="📝 ELN Service&#xa;GET /api/notes/{id}&#xa;x-internal-secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="240" y="370" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="w3" value="📄 Handlebars&#xa;HTML 템플릿 렌더링" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9C27B0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="430" y="370" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="w4" value="🖨️ Puppeteer&#xa;HTML → PDF 변환&#xa;(Chrome headless)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="370" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="wa1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="w2" target="w3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa3" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="w3" target="w4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Worker Step 2: Upload -->
        <mxCell id="w5" value="📁 File Service&#xa;POST /exports/internal/upload&#xa;(multipart PDF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="810" y="370" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="w6" value="💾 MinIO&#xa;exports 버킷 저장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="370" width="130" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="wa4" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="w4" target="w5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa5" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="w5" target="w6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Presigned URL -->
        <mxCell id="w7" value="🔗 Presigned URL 생성&#xa;(24시간 유효)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="370" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="wa6" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF9800;" edge="1" parent="1" source="w6" target="w7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- DB Update + Publish -->
        <mxCell id="w8" value="ExportJob 업데이트&#xa;status: 'completed'&#xa;fileUrl, fileId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="810" y="470" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="w9" value="⚡ Redis PUBLISH&#xa;channel: export-status&#xa;{jobId, status, fileUrl}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="470" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="wa7" style="endArrow=classic;html=1;strokeWidth=1;" edge="1" parent="1" source="w7" target="w8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1275" y="495"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="wa8" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF0000;" edge="1" parent="1" source="w8" target="w9"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- SSE Delivery -->
        <mxCell id="sse-gw" value="🔀 Gateway SSE&#xa;SUBSCRIBE export-status&#xa;userId 필터링" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="810" y="570" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="sse-fe" value="🖥️ Frontend&#xa;event: export-status&#xa;다운로드 링크 표시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="570" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="wa9" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#FF0000;" edge="1" parent="1" source="w9" target="sse-gw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wa10" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1" source="sse-gw" target="sse-fe"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ========== 실패 & 재시도 ========== -->
        <mxCell id="retry-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#EF9A9A;dashed=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="700" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="retry-label" value="실패 &amp; 재시도 흐름" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="50" y="715" width="200" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="fail1" value="처리 실패&#xa;(메모리, 타임아웃)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#F44336;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="750" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="retry-box" value="BullMQ 자동 재시도&#xa;(지수 백오프)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="750" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="retry-times" value="1차: 5초 후&#xa;2차: 10초 후&#xa;3차: 20초 후" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="260" y="810" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="fail-final" value="3회 모두 실패&#xa;status: 'failed'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#F44336;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="750" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="fail-notify" value="SSE로 실패 알림&#xa;{status: 'failed', error}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#F44336;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="810" width="160" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="fa1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#F44336;" edge="1" parent="1" source="fail1" target="retry-box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#F44336;" edge="1" parent="1" source="retry-box" target="fail-final"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa3" style="endArrow=classic;html=1;strokeWidth=1;strokeColor=#F44336;" edge="1" parent="1" source="fail-final" target="fail-notify"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Job Cleanup -->
        <mxCell id="cleanup" value="📋 작업 정리 정책&#xa;&#xa;완료: 최대 100개 보관&#xa;실패: 최대 50개 보관&#xa;Worker 동시성: 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#9E9E9E;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Key Points -->
        <mxCell id="keypoints" value="🔑 핵심 포인트&#xa;&#xa;• 요청 즉시 202 반환 (비동기 처리)&#xa;• Rate Limit: 10 req/60s&#xa;• Presigned URL: 24시간 유효&#xa;• SSE heartbeat: 30초 간격&#xa;• ZIP: 다중 노트 → archiver 압축&#xa;• per-user 필터: requestedBy === userId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="710" width="280" height="140" as="geometry"/>
        </mxCell>

      </root>
